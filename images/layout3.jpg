<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="gold" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#bf953f"/>
      <stop offset="0.25" stop-color="#fcf6ba"/>
      <stop offset="0.5" stop-color="#b38728"/>
      <stop offset="0.75" stop-color="#fbf5b7"/>
      <stop offset="1" stop-color="#aa771c"/>
    </linearGradient>
  </defs>
  <rect width="1920" height="1080" fill="#e8f5e9"/>
  <rect x="60" y="60" width="1800" height="960" rx="40" fill="#fff" stroke="url(#gold)" stroke-width="6"/>
  
  <!-- Central amenities cluster -->
  <ellipse cx="960" cy="540" rx="400" ry="300" fill="#7cb342" opacity="0.3" stroke="url(#gold)" stroke-width="4"/>
  
  <!-- Clubhouse -->
  <rect x="800" y="450" width="320" height="180" rx="15" fill="#e63946"/>
  <text x="960" y="555" fill="#fff" font-size="32" font-weight="900" text-anchor="middle">CLUBHOUSE</text>
  
  <!-- Pool -->
  <rect x="650" y="280" width="200" height="120" rx="12" fill="#4a9eff"/>
  <text x="750" y="355" fill="#fff" font-size="20" font-weight="900" text-anchor="middle">POOL</text>
  
  <!-- Kalyana Mandapam -->
  <rect x="1050" y="280" width="220" height="140" rx="12" fill="url(#gold)"/>
  <text x="1160" y="360" fill="#000" font-size="18" font-weight="900" text-anchor="middle">KALYANA</text>
  <text x="1160" y="385" fill="#000" font-size="18" font-weight="900" text-anchor="middle">MANDAPAM</text>
  
  <!-- Parks -->
  <circle cx="700" cy="700" r="80" fill="#7cb342"/>
  <text x="700" y="710" fill="#fff" font-size="20" font-weight="900" text-anchor="middle">PARK</text>
  
  <circle cx="1220" cy="700" r="80" fill="#7cb342"/>
  <text x="1220" y="710" fill="#fff" font-size="20" font-weight="900" text-anchor="middle">PARK</text>
  
  <!-- Playground -->
  <rect x="850" y="680" width="220" height="100" rx="12" fill="#ffd93d"/>
  <text x="960" y="745" fill="#000" font-size="20" font-weight="900" text-anchor="middle">PLAYGROUND</text>
  
  <!-- Roads around -->
  <path d="M200,200 L1720,200" stroke="url(#gold)" stroke-width="20" fill="none"/>
  <path d="M200,880" L1720,880" stroke="url(#gold)" stroke-width="20" fill="none"/>
  <path d="M200,200 L200,880" stroke="url(#gold)" stroke-width="20" fill="none"/>
  <path d="M1720,200 L1720,880" stroke="url(#gold)" stroke-width="20" fill="none"/>
  
  <!-- Road labels -->
  <rect x="800" y="160" width="320" height="50" rx="10" fill="url(#gold)"/>
  <text x="960" y="195" fill="#000" font-size="28" font-weight="900" text-anchor="middle">100 FT ROAD</text>
  
  <rect x="800" y="885" width="320" height="50" rx="10" fill="url(#gold)"/>
  <text x="960" y="920" fill="#000" font-size="28" font-weight="900" text-anchor="middle">100 FT ROAD</text>
  
  <g fill="#d4af37" font-family="Inter, Arial, sans-serif" text-anchor="middle">
    <text x="960" y="1000" font-size="56" font-weight="900">INFRASTRUCTURE LAYOUT</text>
  </g>
</svg>